# ============================================================
# CC Trader — environment variables (copy to .env)
# ============================================================

# --- Core
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# --- Database
DATABASE_URL=postgresql+asyncpg://cctrader:cctrader@postgres:5432/cctrader
DATABASE_URL_SYNC=postgresql+psycopg2://cctrader:cctrader@postgres:5432/cctrader

# --- Redis
REDIS_URL=redis://redis:6379/0

# --- ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM provider (OpenAI-compatible)
# Pick ONE preset below — Groq is free, Ollama is fully local/offline.
# See docs/FREE_SETUP.md for the full walk-through.

# === Default: OpenAI (paid, best quality)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_CHAT=gpt-4o
OPENAI_MODEL_EMBED=text-embedding-3-large
LLM_DISABLE_JSON_MODE=false

# === Preset A — Groq (free tier, fast Llama 3.3 70B). Recommended.
#   Sign up at https://console.groq.com, create a key, then uncomment:
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL_CHAT=llama-3.3-70b-versatile
# OPENAI_MODEL_EMBED=text-embedding-3-small   # Groq doesn't host embeddings —
#                                              the app falls back to hash vectors
# LLM_DISABLE_JSON_MODE=false

# === Preset B — Ollama (fully local, no internet, no quotas).
#   Install Ollama from ollama.com, run:
#     ollama pull llama3.1:8b
#     ollama pull nomic-embed-text
#   Then uncomment:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL_CHAT=llama3.1:8b
# OPENAI_MODEL_EMBED=nomic-embed-text
# LLM_DISABLE_JSON_MODE=true

# === Preset C — OpenRouter (one account, many models, including Claude).
#   The cheapest way to use Claude in this app — same key works for Claude,
#   Llama, Gemini, and a free Llama 3.3 70B route.
#   Sign up at https://openrouter.ai, add credit (or use the free trial).
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL_CHAT=meta-llama/llama-3.3-70b-instruct:free   # free model
# # OPENAI_MODEL_CHAT=anthropic/claude-3.5-sonnet            # use Claude
# # OPENAI_MODEL_CHAT=google/gemini-2.0-flash-exp:free       # free Gemini
# OPENAI_MODEL_EMBED=text-embedding-3-small
# LLM_DISABLE_JSON_MODE=false

# === Preset D — DeepSeek (very cheap paid, near-Claude quality)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL_CHAT=deepseek-chat
# OPENAI_MODEL_EMBED=text-embedding-3-small
# LLM_DISABLE_JSON_MODE=false

# --- Market data
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Email (for verification + password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cctrader.local

# --- Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- CORS
ALLOWED_ORIGINS=http://localhost:3000

# --- File storage
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50
